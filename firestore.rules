rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'bwetv.ug@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/roles/$(request.auth.token.email))
        && get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role == 'editor';
    }

    function isStaff() {
      return isAdmin() || isEditor();
    }

    match /roles/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'updatedAt'])
        && request.resource.data.role in ['editor', 'moderator'];
      allow delete: if isAdmin();
    }

    match /episodes/{episodeId} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /shows/{showId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin()
        || (isEditor() && settingId in ['homeContent', 'programSchedule', 'showsHero']);
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 800000
        && request.resource.data.dataUrl.matches('^data:image/(webp|png|jpeg);base64,.*');
      allow delete: if isStaff();
    }

    match /analytics/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['day', 'page', 'views'])
        && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.page is string && request.resource.data.page.matches('^[a-z0-9-]{1,40}$')
        && docId == request.resource.data.day + '_' + request.resource.data.page
        && request.resource.data.views == 1;
      allow update: if resource.data.keys().hasOnly(['day', 'page', 'views'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
      allow delete: if false;
    }

    match /pages/{pageId} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create, update, delete: if isStaff();

      match /revisions/{revisionId} {
        allow read, write: if isStaff();
      }
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'photoData'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 30))
        && (!('photoData' in request.resource.data) || request.resource.data.photoData.size() < 200000);
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['userId', 'name', 'text', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /newsletter/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email == email
        && email.size() < 255
        && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
